@@ -0,0 +1,44 @@
+/* Both case routes build the committed payloads byte for byte, and a variant's item13
+ * block reports method means. 2026-10-21: the uncached route treated its canonical
+ * bounded-runtime base as a variant and printed first-method item13 parts (failure-catalog). */
+"use strict";
+const assert=require("assert"),fs=require("fs"),path=require("path"),crypto=require("crypto"),{spawnSync}=require("child_process");
+const sha=s=>crypto.createHash("sha256").update(s).digest("hex"),sum=a=>a.reduce((x,y)=>x+y,0),mean=a=>sum(a)/a.length;
+const mode=process.argv[2];
+if(mode==="--payload"){
+ const P=require("./package.cjs"),text=x=>JSON.stringify(x,null,1)+"\n";
+ const out={set:sha(text(P.correctionsPayload())),cash:sha(text(P.CASH.correctionsPayload()))};
+ require("./memory_guard.cjs").requireWithinBudget("test_routes payload "+(process.env.V9_CASE_CACHE==="0"?"uncached":"cached"));
+ console.log("ROUTE "+JSON.stringify(out));return;
+}
+if(mode==="--variant"){
+ const P=require("./package.cjs"),V=P.V8_PACKAGE,id="veterans_compensation";
+ const Q=P.caseOf(P.OCT05,V.CANDIDATE.slice(0,-1).concat(id));
+ for(const X of [Q,Q.CASH]){
+  const b=X.POST_ENGINE[id],rec=X.V9_ITEMS.find(r=>r.id===id);
+  assert.ok(b.generation_transport,"variant must take the repricing branch");
+  for(const end of ["low","high"]){
+   const e=b.by_end[end],ms=Object.values(e.by_method);
+   assert.strictEqual(b[end],e.total_bn);assert.strictEqual(rec.total_bn[end],e.total_bn);
+   assert.ok(Math.abs(e.total_bn-sum(e.parts.map(p=>p.delta_bn)))<1e-9);
+   for(const [part,v]of Object.entries(e.by_part||{}))assert.ok(Math.abs(v-sum(e.parts.filter(p=>p.part===part).map(p=>p.delta_bn)))<1e-9,part);
+   e.parts.forEach((p,j)=>{for(const f of ["amount_bn","before_bn","after_bn","delta_bn"])if(Number.isFinite(p[f]))assert.ok(Math.abs(p[f]-mean(ms.map(m=>m.parts[j][f])))<1e-9,end+"/"+p.line+"/"+f);});
+  }
+ }
+ require("./memory_guard.cjs").requireWithinBudget("test_routes variant");
+ console.log("VARIANT ok");return;
+}
+const child=(arg,env)=>{
+ const r=spawnSync(process.execPath,[__filename,arg],{env:{...process.env,...env},encoding:"utf8",maxBuffer:1<<24});
+ if(r.status!==0)throw Error("[BLOCKED] test_routes child "+arg+" "+JSON.stringify(env)+": "+(r.stderr||r.signal));
+ return r.stdout;
+};
+const derived=Object.fromEntries([["set","corrections.json"],["cash","corrections_cash.json"]].map(([k,f])=>[k,sha(fs.readFileSync(path.join(__dirname,"derived",f)))]));
+const routes={};
+for(const [name,env]of [["cached",{}],["uncached",{V9_CASE_CACHE:"0"}]]){
+ const line=child("--payload",env).split("\n").find(l=>l.startsWith("ROUTE "));
+ routes[name]=JSON.parse(line.slice(6));
+ assert.deepStrictEqual(routes[name],derived,name+" route payload differs from derived/");
+}
+assert.ok(child("--variant",{V9_CASE_CACHE:"0"}).includes("VARIANT ok"));
+console.log("PASS routes: cached and uncached payloads equal derived/ (set "+derived.set.slice(0,12)+", cash "+derived.cash.slice(0,12)+"); variant item13 parts are method means");
