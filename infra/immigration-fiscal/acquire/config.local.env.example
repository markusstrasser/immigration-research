# Machine-specific overrides — copy to config.local.env (gitignored):
#   cp acquire/config.local.env.example acquire/config.local.env
#
# Portable defaults live in config.env.example; only set overrides here.

IMMIGRATION_FISCAL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export REPO_ROOT="${REPO_ROOT:-$(cd "$IMMIGRATION_FISCAL_ROOT/../.." && pwd)}"

# Defaults keep all dataset bytes inside this project. Override only deliberately.
# export PNY_DATA_ROOT="$REPO_ROOT/sources/immigration-fiscal/data"
# export CORPUS_ROOT="$REPO_ROOT/sources/corpus"
# export DERIVED_ROOT="$REPO_ROOT/sources/immigration-fiscal/derived"
# export REUSED_SURVEYS_ROOT="$REPO_ROOT/sources/reused-surveys"
# export IMMIGRATION_CAUSAL_DATA="$REPO_ROOT/sources/immigration-causal/data"
