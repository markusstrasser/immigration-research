{"version":"2.0","class":"dataset","label":"Persons suspected of solved offences by nationality, permanent residents of Finland by Year, Nationality, Offence group and specifier for criminal act, Wellbeing services county and Information","source":"Statistics Finland, statistics on offences and coercive measures","updated":"2026-09-03T05:00:00Z","note":["The data on wellbeing services counties published in database tables 13fr, 13je, 13iz, 13jg, 13jm, 13jz, 13rd and 157p were erroneous. Specified data for the wellbeing services county of Kainuu were missing from the tables. The data for Kainuu were included when calculating data for the whole country, but specified regional data were excluded from the tables. The data were corrected on 3 September 2026.","<A HREF='https://stat.fi/en/statistics/documentation/rpk' TARGET=_blank>Documentation of statistics</A>",".. not applicable","13jg -- Persons suspected of solved offences living permanently in Finland by nationality, wellbeing services county, by calculation method and year of solving per 10,000 population, 2000-2025, Statistics on offences and coercive measures, Statistics Finland"],"role":{"time":["timeperiod_y"],"geo":["valtio_19_20190101","alue_23_20230101"],"metric":["contentscode"]},"id":["timeperiod_y","valtio_19_20190101","rikokset_74_20211209","alue_23_20230101","contentscode"],"size":[26,87,1,1,6],"dimension":{"timeperiod_y":{"label":"Year","category":{"index":{"2000":0,"2001":1,"2002":2,"2003":3,"2004":4,"2005":5,"2006":6,"2007":7,"2008":8,"2009":9,"2010":10,"2011":11,"2012":12,"2013":13,"2014":14,"2015":15,"2016":16,"2017":17,"2018":18,"2019":19,"2020":20,"2021":21,"2022":22,"2023":23,"2024":24,"2025":25},"label":{"2000":"2000","2001":"2001","2002":"2002","2003":"2003","2004":"2004","2005":"2005","2006":"2006","2007":"2007","2008":"2008","2009":"2009","2010":"2010","2011":"2011","2012":"2012","2013":"2013","2014":"2014","2015":"2015","2016":"2016","2017":"2017","2018":"2018","2019":"2019","2020":"2020","2021":"2021","2022":"2022","2023":"2023","2024":"2024","2025":"2025"}},"extension":{"elimination":false,"show":"value"}},"valtio_19_20190101":{"label":"Nationality","note":["Citizenship refers to a person's legal nationality in a certain country. Citizenship is usually determined at birth, but it may be changed upon moving to live in another country. A person may also be a citizen of more than one country (see Nationality Act, 359/2003 and Nationality Decree, 699/1985). Persons with both Finnish and foreign citizenship will be entered in the statistics as Finnish nationals. If a foreign national living in Finland has several nationalities, that person will be entered in the register and statistics as a national of the country on whose passport he or she arrived in the country."],"category":{"index":{"SSS":0,"246":1,"ULK":2,"EUR":3,"528":4,"008":5,"056":6,"070":7,"100":8,"891":9,"724":10,"372":11,"380":12,"040":13,"300":14,"191":15,"428":16,"440":17,"498":18,"578":19,"807":20,"620":21,"616":22,"250":23,"642":24,"752":25,"276":26,"688":27,"703":28,"756":29,"208":30,"203":31,"792":32,"804":33,"348":34,"112":35,"643":36,"233":37,"826":38,"AFR":39,"012":40,"024":41,"818":42,"736":43,"232":44,"231":45,"270":46,"288":47,"120":48,"404":49,"180":50,"504":51,"566":52,"686":53,"706":54,"729":55,"834":56,"788":57,"AME":58,"076":59,"124":60,"192":61,"484":62,"840":63,"AAS":64,"004":65,"050":66,"608":67,"268":68,"356":69,"368":70,"364":71,"376":72,"392":73,"398":74,"156":75,"104":76,"524":77,"586":78,"144":79,"760":80,"764":81,"860":82,"704":83,"OSE":84,"991":85,"X":86},"label":{"SSS":"TOTAL","246":"Finland","ULK":"FOREIGN COUNTRIES, TOTAL","EUR":"EUROPE","528":"Netherlands","008":"Albania","056":"Belgium","070":"Bosnia and Herzegovina","100":"Bulgaria","891":"Former Serbia and Montenegro","724":"Spain","372":"Ireland","380":"Italy","040":"Austria","300":"Greece","191":"Croatia","428":"Latvia","440":"Lithuania","498":"Moldova","578":"Norway","807":"North Macedonia","620":"Portug